ENVIRONMENT=development
DATABASE_URL=sqlite:///./marketpilot.db
CORS_ORIGINS=["http://localhost:3000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","backend"]
COOKIE_SECURE=false
SESSION_HOURS=24
AI_ENABLED=false
# Set only on the backend. Never use a NEXT_PUBLIC_ variable for this key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Local Compose UI origin. Set your real HTTPS domain for production.
APP_ORIGIN=http://localhost:3000
# Optional n8n schedule timezone; change before activating workflows.
TZ=UTC
# Production overlay requires actual DNS names:
# APP_DOMAIN=app.your-domain.example
# API_DOMAIN=api.your-domain.example
